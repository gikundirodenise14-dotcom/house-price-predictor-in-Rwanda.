    "def remove_outliers(data, col):\n",
    "    Q1 = data[col].quantile(0.25)\n",
    "    Q3 = data[col].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower, upper = Q1 - 1.5 * IQR, Q3 + 1.5 * IQR\n",
    "    before = len(data)\n",
    "    data_filtered = data[(data[col] >= lower) & (data[col] <= upper)]\n",
    "    print(f\"   {col}: identified {before - len(data_filtered)} outliers (values outside {lower:.1f} to {upper:.1f})\")\n",
    "    return data_filtered\n",
    "\n",
    "print(\"3.4 Outlier identification (IQR) without modifying the original DataFrame:\")\n",
    "\n",
    "temp_df = df.copy()\n",
    "\n",
    "numerical_cols = ['Area_m2', 'Bedrooms', 'Bathrooms', 'House_Age_Years', 'Distance_to_City_km', 'Parking_Spaces', 'House_Price_Million_RWF']\n",
    "\n",
    "for col in numerical_cols:\n",
    "    temp_df = remove_outliers(temp_df, col)\n",
    "\n",
    "print(f\"\\nOriginal DataFrame shape remains: {df.shape}\")\n",
    "print(f\"Temporary DataFrame shape after identifying potential outliers: {temp_df.shape}\")"
   ]
